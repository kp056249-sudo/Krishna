# ==============================================================================
# DATANEXUS ENTERPRISE ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file or real secrets to Git.

# Server & Runtime Environment
NODE_ENV=production
PORT=3000
APP_URL=

# ------------------------------------------------------------------------------
# 1. SUPABASE DATABASE & AUTHENTICATION
# ------------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
DATABASE_URL=

# ------------------------------------------------------------------------------
# 2. GOOGLE GEMINI AI (Dual Engine + Calls Auto-Failover)
# ------------------------------------------------------------------------------
# Engine 1: Screen Chat AI (2 Keys Pool)
GEMINI_CHAT_KEY=
GEMINI_CHAT_KEY_2=
GEMINI_CHAT_MODEL=gemini-2.5-flash

# Engine 2: Live Calls & Operations AI (2 Keys Pool)
GEMINI_CALLS_KEY=
GEMINI_CALLS_KEY_2=
GEMINI_CALLS_MODEL=gemini-2.5-flash

# Default Store AI Keys & Model
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 3. META WHATSAPP BUSINESS CLOUD API (Official v21.0)
# ------------------------------------------------------------------------------
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
FOUNDER_WHATSAPP_PHONE=
META_SENDER_TEST_NUMBER=

# Meta WhatsApp Aliases
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
META_APP_SECRET=

# ------------------------------------------------------------------------------
# 4. DATA SECURITY & ENCRYPTION
# ------------------------------------------------------------------------------
# 32-byte hex string for AES-256-GCM token encryption
ENCRYPTION_KEY=

# ------------------------------------------------------------------------------
# 5. RAZORPAY PAYMENT GATEWAY
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 6. SHIPROCKET & 3PL LOGISTICS
# ------------------------------------------------------------------------------
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_API_TOKEN=
DELHIVERY_API_KEY=

# ------------------------------------------------------------------------------
# 7. E-COMMERCE INTEGRATIONS (Shopify & WooCommerce)
# ------------------------------------------------------------------------------
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_CLIENT_SECRET=
WOOCOMMERCE_STORE_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=

# ------------------------------------------------------------------------------
# 8. FIREBASE CLOUD FIRESTORE (Optional)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
