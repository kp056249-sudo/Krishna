{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with verified companyId and role",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "companyId": { "type": "string" },
        "role": { "type": "string", "enum": ["owner", "admin", "analyst", "viewer"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email", "companyId", "role"]
    },
    "Company": {
      "title": "Company",
      "description": "Tenant enterprise company record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "ownerUid": { "type": "string" },
        "currency": { "type": "string", "enum": ["INR", "USD"] },
        "gstin": { "type": "string" },
        "address": { "type": "string" },
        "subscriptionPlan": { "type": "string", "enum": ["starter", "growth", "vip_enterprise"] },
        "subscriptionExpiresAt": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "ownerUid"]
    },
    "Store": {
      "title": "Store",
      "description": "Connected e-commerce storefront",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "name": { "type": "string" },
        "platform": { "type": "string", "enum": ["shopify", "woocommerce", "amazon", "file_import"] },
        "url": { "type": "string" },
        "status": { "type": "string", "enum": ["connected", "syncing", "error", "disconnected"] },
        "lastSyncTime": { "type": "string" },
        "dailyRevenue": { "type": "number" },
        "dailyOrders": { "type": "number" }
      },
      "required": ["id", "companyId", "name", "platform", "status"]
    },
    "Order": {
      "title": "Order",
      "description": "Real transaction order record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "orderNumber": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "pincode": { "type": "string" },
        "totalAmount": { "type": "number" },
        "paymentMode": { "type": "string", "enum": ["COD", "PREPAID"] },
        "status": { "type": "string" },
        "rtoRiskScore": { "type": "number" },
        "courierPartner": { "type": "string" },
        "awb": { "type": "string" },
        "cogs": { "type": "number" },
        "source": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "companyId", "orderNumber", "totalAmount", "status"]
    },
    "InventoryItem": {
      "title": "InventoryItem",
      "description": "Warehouse SKU record",
      "type": "object",
      "properties": {
        "sku": { "type": "string" },
        "name": { "type": "string" },
        "inStock": { "type": "number" },
        "dailyVelocity": { "type": "number" },
        "daysOfRunway": { "type": "number" },
        "reorderPoint": { "type": "number" },
        "status": { "type": "string", "enum": ["healthy", "low_stock", "critical", "dead_stock"] },
        "cogs": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["sku", "name", "inStock"]
    },
    "AbandonedCart": {
      "title": "AbandonedCart",
      "description": "Dropped checkout lead",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "customerPhone": { "type": "string" },
        "cartValue": { "type": "number" },
        "checkoutUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["abandoned", "recovered", "notified"] },
        "nudgeCount": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "companyId", "customerPhone"]
    },
    "AdAccount": {
      "title": "AdAccount",
      "description": "Meta or Google Ads account",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "platform": { "type": "string", "enum": ["meta", "google"] },
        "name": { "type": "string" },
        "spend": { "type": "number" },
        "roas": { "type": "number" },
        "status": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "platform", "name"]
    },
    "Integration": {
      "title": "Integration",
      "description": "Encrypted 3P service credentials",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "service": { "type": "string" },
        "credentials": { "type": "string" },
        "status": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "service", "credentials"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable event log",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "action": { "type": "string" },
        "details": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "userId", "action", "timestamp"]
    },
    "AutopilotRule": {
      "title": "AutopilotRule",
      "description": "Autonomous agent logic rule",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "trigger": { "type": "string" },
        "action": { "type": "string" },
        "active": { "type": "boolean" },
        "stats": { "type": "string" }
      },
      "required": ["id", "title", "active"]
    },
    "Message": {
      "title": "Message",
      "description": "WhatsApp/SMS dispatch record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sid": { "type": "string" },
        "to": { "type": "string" },
        "body": { "type": "string" },
        "status": { "type": "string" },
        "provider": { "type": "string" },
        "timestamp": { "type": "string" },
        "error": { "type": "string" }
      },
      "required": ["id", "to", "body", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles"
    },
    "/companies/{companyId}": {
      "schema": { "$ref": "#/entities/Company" },
      "description": "Companies"
    },
    "/companies/{companyId}/stores/{storeId}": {
      "schema": { "$ref": "#/entities/Store" },
      "description": "Stores"
    },
    "/companies/{companyId}/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Orders"
    },
    "/companies/{companyId}/inventory/{sku}": {
      "schema": { "$ref": "#/entities/InventoryItem" },
      "description": "Inventory"
    },
    "/companies/{companyId}/abandonedCarts/{cartId}": {
      "schema": { "$ref": "#/entities/AbandonedCart" },
      "description": "Abandoned Carts"
    },
    "/companies/{companyId}/adAccounts/{accountId}": {
      "schema": { "$ref": "#/entities/AdAccount" },
      "description": "Ad Accounts"
    },
    "/companies/{companyId}/integrations/{integrationId}": {
      "schema": { "$ref": "#/entities/Integration" },
      "description": "Integrations"
    },
    "/companies/{companyId}/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Audit Logs"
    },
    "/companies/{companyId}/autopilotRules/{ruleId}": {
      "schema": { "$ref": "#/entities/AutopilotRule" },
      "description": "Autopilot Rules"
    },
    "/companies/{companyId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "Message Logs"
    }
  }
}
